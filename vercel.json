{
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/index.html", "destination": "/api" }
  ],
  "functions": {
    "src/server.ts": {
      "maxDuration": 300,
      "includeFiles": "{web/**,fixtures/**,agent/**,src/knowledge/**,modulo/**}"
    },
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "{web/**,fixtures/**,agent/**,src/knowledge/**,modulo/**}"
    },
    "api/[...path].ts": {
      "maxDuration": 300,
      "includeFiles": "{web/**,fixtures/**,agent/**,src/knowledge/**,modulo/**}"
    }
  }
}
