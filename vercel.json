{
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/index.html", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "fixtures/**,agent/**,web/**,src/knowledge/**,modulo/**"
    },
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "fixtures/**,agent/**,web/**,src/knowledge/**,modulo/**"
    }
  }
}
