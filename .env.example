# Si esta clave tiene valor, el agente usa Anthropic. Nunca la pongas en el repo ni en el front.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Alternativa OpenAI-compatible. Las pruebas de esta entrega corrieron con Groq.
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3.8-27b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Topes para que una sesión no consuma la clave sin límite.
MAX_TOOL_ITERATIONS=25
MAX_SESSION_TOKENS=80000
LLM_TIMEOUT_MS=60000

PORT=3000
