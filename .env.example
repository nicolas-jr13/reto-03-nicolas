# Clave de Groq (https://console.groq.com/keys). Solo vive en el entorno del backend.
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3.8-27b
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Topes para que una sesión no consuma la clave sin límite.
MAX_TOOL_ITERATIONS=25
MAX_SESSION_TOKENS=80000
LLM_TIMEOUT_MS=60000

PORT=3000
